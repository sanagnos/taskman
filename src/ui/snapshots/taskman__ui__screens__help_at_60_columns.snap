" taskman    │  ENG-52       /src/acme-ENG-52 eng-52-login   "
" ╭ Help ──────────────────────────────────────────────────╮ "
"▾│                                                        │ "
" │  Every key goes to the session, except after the       │ "
" │  ctrl+a prefix:                                        │ "
"┃│                                                        │ "
" │    ctrl+a [ / ]      previous / next ticket            │ "
" │    ctrl+a { / }      move the card; ↑/↓ go on, p       │ "
" │                      moves its project, Enter ends     │ "
" │    ctrl+a ctrl+a     next ticket needing you, else     │ "
"▸│                      one that finished (also tab)      │ "
" │    ctrl+a /          jump to a ticket, agent or        │ "
" │                      project by typing                 │ "
" │    ctrl+a w          list the sessions that need you,  │ "
" │                      oldest first, with what they ask  │ "
" │    ctrl+a n          add a ticket, or an agent with    │ "
" │                      no ticket                         │ "
" │    ctrl+a ,          settings: prefix key, updates,    │ "
" │                      sessions, theme, notifications,   │ "
" │                                                        │ "
" │  ↑/↓ scroll   1-16 of 69   other keys close            │ "
" │                                                        │ "
